{
  "opencollection": "1.0.0",
  "info": {
    "name": "Citrix ADC (NetScaler) NITRO Access Policies Devices API",
    "version": "14.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "NITRO_AUTH_TOKEN",
      "value": "{{NITRO_AUTH_TOKEN}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Devices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix Filter devices",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{netscaler-ip}/nitro/v1/device/filter",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Search and filter enrolled devices based on criteria."
        },
        {
          "info": {
            "name": "Citrix Get device details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{netscaler-ip}/nitro/v1/device/:deviceId",
            "params": [
              {
                "name": "deviceId",
                "value": "",
                "type": "path",
                "description": "Device unique identifier"
              }
            ]
          },
          "docs": "Retrieve detailed information about a specific enrolled device."
        },
        {
          "info": {
            "name": "Citrix Wipe a device",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{netscaler-ip}/nitro/v1/device/wipe",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Issue a full wipe command to a managed device."
        },
        {
          "info": {
            "name": "Citrix Selective wipe a device",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{netscaler-ip}/nitro/v1/device/selectivewipe",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Issue a selective wipe to remove only corporate data from a device."
        }
      ]
    }
  ],
  "bundled": true
}