{
  "opencollection": "1.0.0",
  "info": {
    "name": "Citrix Secure Private Access API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Applications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix List applications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.com/accessSecurity/applications",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ]
          },
          "docs": "Retrieve all applications configured in Secure Private Access."
        },
        {
          "info": {
            "name": "Citrix Create an application",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.com/accessSecurity/applications",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new application configuration for secure private access."
        },
        {
          "info": {
            "name": "Citrix Get an application",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.com/accessSecurity/applications/:applicationId",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application unique identifier"
              }
            ]
          },
          "docs": "Retrieve details of a specific application."
        },
        {
          "info": {
            "name": "Citrix Update an application",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.cloud.com/accessSecurity/applications/:applicationId",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application unique identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing application configuration."
        },
        {
          "info": {
            "name": "Citrix Delete an application",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.cloud.com/accessSecurity/applications/:applicationId",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application unique identifier"
              }
            ]
          },
          "docs": "Delete an application configuration."
        }
      ]
    },
    {
      "info": {
        "name": "Access Policies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix List access policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.com/accessSecurity/policies",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ]
          },
          "docs": "Retrieve all access policies configured for secure private access."
        },
        {
          "info": {
            "name": "Citrix Create an access policy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.com/accessSecurity/policies",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new zero trust access policy."
        }
      ]
    },
    {
      "info": {
        "name": "Certificates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix Upload a certificate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.com/accessSecurity/certificate",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Upload a new SSL certificate for use with applications."
        }
      ]
    },
    {
      "info": {
        "name": "Application Domains",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix Get domain certificate for an application",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.com/accessSecurity/application/:applicationId/domain/:encodedURL",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application unique identifier"
              },
              {
                "name": "encodedURL",
                "value": "",
                "type": "path",
                "description": "URL-encoded domain name"
              }
            ]
          },
          "docs": "Retrieve the certificate associated with a specific application domain."
        },
        {
          "info": {
            "name": "Citrix Associate certificate with application domain",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.cloud.com/accessSecurity/application/:applicationId/domain/:encodedURL",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application unique identifier"
              },
              {
                "name": "encodedURL",
                "value": "",
                "type": "path",
                "description": "URL-encoded domain name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Associate an SSL certificate with a specific application domain."
        }
      ]
    }
  ],
  "bundled": true
}