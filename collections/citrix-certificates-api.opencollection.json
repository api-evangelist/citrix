{
  "opencollection": "1.0.0",
  "info": {
    "name": "Citrix ADC (NetScaler) NITRO Access Policies Certificates API",
    "version": "14.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "NITRO_AUTH_TOKEN",
      "value": "{{NITRO_AUTH_TOKEN}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Certificates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix Upload a certificate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{netscaler-ip}/nitro/v1/certificate",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Upload a new SSL certificate for use with applications."
        }
      ]
    }
  ],
  "bundled": true
}