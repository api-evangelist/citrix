{
  "opencollection": "1.0.0",
  "info": {
    "name": "Citrix ADC (NetScaler) NITRO Access Policies Users API",
    "version": "14.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "NITRO_AUTH_TOKEN",
      "value": "{{NITRO_AUTH_TOKEN}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix Filter users",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{netscaler-ip}/nitro/v1/user/filter",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Search and filter users and groups."
        }
      ]
    }
  ],
  "bundled": true
}