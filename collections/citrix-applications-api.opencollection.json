{
  "opencollection": "1.0.0",
  "info": {
    "name": "Citrix ADC (NetScaler) NITRO Access Policies Applications API",
    "version": "14.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "NITRO_AUTH_TOKEN",
      "value": "{{NITRO_AUTH_TOKEN}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Applications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix List applications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{netscaler-ip}/nitro/v1/Applications",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              },
              {
                "name": "Citrix-InstanceId",
                "value": ""
              }
            ]
          },
          "docs": "Retrieve all published applications within the customer site."
        },
        {
          "info": {
            "name": "Citrix Get an application",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{netscaler-ip}/nitro/v1/Applications/:applicationId",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              },
              {
                "name": "Citrix-InstanceId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application unique identifier"
              }
            ]
          },
          "docs": "Retrieve details of a specific published application."
        },
        {
          "info": {
            "name": "Citrix Filter applications",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{netscaler-ip}/nitro/v1/application/filter",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Search and filter managed applications."
        },
        {
          "info": {
            "name": "Citrix List applications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{netscaler-ip}/nitro/v1/applications",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ]
          },
          "docs": "Retrieve all applications configured in Secure Private Access."
        },
        {
          "info": {
            "name": "Citrix Create an application",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{netscaler-ip}/nitro/v1/applications",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new application configuration for secure private access."
        },
        {
          "info": {
            "name": "Citrix Get an application",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{netscaler-ip}/nitro/v1/applications/:applicationId",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application unique identifier"
              }
            ]
          },
          "docs": "Retrieve details of a specific application."
        },
        {
          "info": {
            "name": "Citrix Update an application",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{netscaler-ip}/nitro/v1/applications/:applicationId",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application unique identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing application configuration."
        },
        {
          "info": {
            "name": "Citrix Delete an application",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{netscaler-ip}/nitro/v1/applications/:applicationId",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application unique identifier"
              }
            ]
          },
          "docs": "Delete an application configuration."
        }
      ]
    }
  ],
  "bundled": true
}