{
  "opencollection": "1.0.0",
  "info": {
    "name": "Citrix ADC (NetScaler) NITRO Access Policies System API",
    "version": "14.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "NITRO_AUTH_TOKEN",
      "value": "{{NITRO_AUTH_TOKEN}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix Get system statistics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{netscaler-ip}/nitro/v1/stat/ns"
          },
          "docs": "Retrieve system-level statistics including CPU, memory, and throughput."
        },
        {
          "info": {
            "name": "Citrix Get system configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{netscaler-ip}/nitro/v1/config/nsconfig"
          },
          "docs": "Retrieve the current NetScaler system configuration."
        }
      ]
    }
  ],
  "bundled": true
}