{
  "opencollection": "1.0.0",
  "info": {
    "name": "Citrix Cloud API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix Obtain access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.com/cctrustoauth2/:customerId/tokens/clients",
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "Citrix Cloud customer ID"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Authenticate using OAuth 2.0 Client Credentials grant to obtain a bearer token for accessing Citrix Cloud APIs."
        }
      ]
    },
    {
      "info": {
        "name": "Service Principals",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix List service principals",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.com/serviceprincipals",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ]
          },
          "docs": "Retrieve all service principals for the authenticated customer."
        },
        {
          "info": {
            "name": "Citrix Create a service principal",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.com/serviceprincipals",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new service principal for API automation within the customer."
        },
        {
          "info": {
            "name": "Citrix Get a service principal",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.com/serviceprincipals/:principalId",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "principalId",
                "value": "",
                "type": "path",
                "description": "Service principal unique identifier"
              }
            ]
          },
          "docs": "Retrieve details of a specific service principal by ID."
        },
        {
          "info": {
            "name": "Citrix Delete a service principal",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.cloud.com/serviceprincipals/:principalId",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "principalId",
                "value": "",
                "type": "path",
                "description": "Service principal unique identifier"
              }
            ]
          },
          "docs": "Delete a service principal by ID."
        }
      ]
    },
    {
      "info": {
        "name": "Resource Locations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix List resource locations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.com/resourcelocations",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ]
          },
          "docs": "Retrieve all resource locations configured for the customer."
        },
        {
          "info": {
            "name": "Citrix Get a resource location",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.com/resourcelocations/:locationId",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Resource location unique identifier"
              }
            ]
          },
          "docs": "Retrieve details of a specific resource location by ID."
        }
      ]
    },
    {
      "info": {
        "name": "Notifications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix List notifications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.com/notifications",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              }
            ]
          },
          "docs": "Retrieve platform notifications for the customer."
        }
      ]
    }
  ],
  "bundled": true
}