{
  "opencollection": "1.0.0",
  "info": {
    "name": "Citrix ADC (NetScaler) NITRO Access Policies SSL API",
    "version": "14.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "NITRO_AUTH_TOKEN",
      "value": "{{NITRO_AUTH_TOKEN}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "SSL",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix List SSL certificate-key pairs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{netscaler-ip}/nitro/v1/config/sslcertkey"
          },
          "docs": "Retrieve all SSL certificate and key pair configurations."
        }
      ]
    }
  ],
  "bundled": true
}