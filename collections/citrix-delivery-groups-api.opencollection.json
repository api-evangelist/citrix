{
  "opencollection": "1.0.0",
  "info": {
    "name": "Citrix ADC (NetScaler) NITRO Access Policies Delivery Groups API",
    "version": "14.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "NITRO_AUTH_TOKEN",
      "value": "{{NITRO_AUTH_TOKEN}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Delivery Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Citrix List delivery groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{netscaler-ip}/nitro/v1/DeliveryGroups",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              },
              {
                "name": "Citrix-InstanceId",
                "value": ""
              }
            ]
          },
          "docs": "Retrieve all delivery groups configured within the customer site."
        },
        {
          "info": {
            "name": "Citrix Create a delivery group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{netscaler-ip}/nitro/v1/DeliveryGroups",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              },
              {
                "name": "Citrix-InstanceId",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new delivery group for assigning resources to users."
        },
        {
          "info": {
            "name": "Citrix Get a delivery group",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{netscaler-ip}/nitro/v1/DeliveryGroups/:deliveryGroupId",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              },
              {
                "name": "Citrix-InstanceId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "deliveryGroupId",
                "value": "",
                "type": "path",
                "description": "Delivery group unique identifier"
              }
            ]
          },
          "docs": "Retrieve details of a specific delivery group."
        },
        {
          "info": {
            "name": "Citrix Update a delivery group",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{netscaler-ip}/nitro/v1/DeliveryGroups/:deliveryGroupId",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              },
              {
                "name": "Citrix-InstanceId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "deliveryGroupId",
                "value": "",
                "type": "path",
                "description": "Delivery group unique identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update properties of an existing delivery group."
        },
        {
          "info": {
            "name": "Citrix Delete a delivery group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{netscaler-ip}/nitro/v1/DeliveryGroups/:deliveryGroupId",
            "headers": [
              {
                "name": "Citrix-CustomerId",
                "value": ""
              },
              {
                "name": "Citrix-InstanceId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "deliveryGroupId",
                "value": "",
                "type": "path",
                "description": "Delivery group unique identifier"
              }
            ]
          },
          "docs": "Delete an existing delivery group."
        },
        {
          "info": {
            "name": "Citrix Filter delivery groups",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{netscaler-ip}/nitro/v1/deliverygroup/filter",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Search and filter delivery groups."
        }
      ]
    }
  ],
  "bundled": true
}